# Local values for the first three come from `pnpm env:local`
# (reads `supabase status`). Never commit real values.

# Supabase (new API keys; the legacy anon/service_role JWT keys are not used)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56721
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by the ingest worker and admin jobs ONLY, never for
# retrieval, Slack or MCP requests.
SUPABASE_SECRET_KEY=

# Anthropic (needed from M3)
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
HELPER_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-opus-5-5
