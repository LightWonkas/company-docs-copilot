{
  "name": "company-docs-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:start": "node scripts/ensure-signing-key.ts && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "env:local": "node scripts/env-local.ts",
    "seed": "node scripts/seed.ts",
    "check:secrets": "node .claude/hooks/block-secrets.mjs --tracked",
    "db:types": "supabase gen types typescript > src/lib/supabase/database.types.ts",
    "test:mutation": "node scripts/mutation-test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "26.x"
  }
}
