{
  "name": "company-docs-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:start": "tsx scripts/ensure-signing-key.ts && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "env:local": "tsx scripts/env-local.ts",
    "seed": "tsx scripts/seed.ts",
    "check:secrets": "node .claude/hooks/block-secrets.mjs --tracked",
    "db:types": "tsx scripts/gen-types.ts",
    "test:mutation": "tsx scripts/mutation-test.ts",
    "ingest:worker": "tsx scripts/ingest-worker.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval": "tsx evals/run.ts",
    "eval:smoke": "tsx evals/run.ts --smoke",
    "eval:calibrate": "tsx evals/calibrate.ts",
    "eval:ablate": "tsx evals/ablate.ts",
    "eval:kappa": "tsx evals/kappa.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.11.0",
    "@base-ui/react": "^1.9.0",
    "@huggingface/transformers": "4.3.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "mammoth": "^1.13.0",
    "next": "16.4.6",
    "onnxruntime-node": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "26.x"
  }
