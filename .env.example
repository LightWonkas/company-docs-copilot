# Local values for the first three come from `pnpm env:local`
# (reads `supabase status`). Never commit real values.

# Supabase (new API keys; the legacy anon/service_role JWT keys are not used)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56721
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by the ingest worker and admin jobs ONLY, never for
# retrieval, Slack or MCP requests.
SUPABASE_SECRET_KEY=

# Anthropic (needed from M3)
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
HELPER_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-opus-5-5

# LLM provider for answers and helpers: anthropic (default) or openai-compatible
# (a company-hosted model: Ollama, vLLM, LM Studio). See README "Running with a
# local model". The eval judge always uses Anthropic.
LLM_PROVIDER=anthropic
# OpenAI-style base URL including /v1 (Ollama: http://localhost:11434/v1,
# LM Studio: http://localhost:1234/v1, vLLM: http://<host>:8000/v1)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
# Optional smaller model for rewrite/rerank/screen/context (defaults to LOCAL_LLM_MODEL)
LOCAL_LLM_HELPER_MODEL=
# Only if the local server enforces a key (vLLM --api-key, a gateway)
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_MS=120000

# App URL used for magic-link redirects when the request has no Origin header
APP_URL=http://localhost:3100

# Demo login for seeded personas (`pnpm env:local` generates a random local password).
# Keep DEMO_MODE off in any environment with real users.
DEMO_MODE=false
DEMO_PASSWORD=

# transformers.js model cache (downloaded on first use)
MODEL_CACHE_DIR=.cache/models

# Vercel Cron -> /api/cron/ingest (ingest worker)
CRON_SECRET=

# Slack (M7): request signing, bot token, and the HMAC secret for account-link URLs
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_LINK_SECRET=

# Optional rerankers / tuning
RERANKER=
VOYAGE_API_KEY=
COHERE_API_KEY=
ANSWER_EFFORT=medium
